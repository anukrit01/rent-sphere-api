# ==============================================================================
# RentSphere API - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Generate cryptographically secure JWT secrets using:
#   openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Client Origins (comma-separated for multiple origins, e.g., http://localhost:4200,https://rentsphere.vercel.app)
CORS_ORIGIN=http://localhost:4200

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rentsphere_db?schema=public

# ------------------------------------------------------------------------------
# 3. JWT Authentication Secrets (Minimum 32 characters)
# ------------------------------------------------------------------------------
# MUST be distinct secrets for access and refresh tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_rand
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_rand
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Media Storage (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# 6. Logging
# ------------------------------------------------------------------------------
# Options: fatal, error, warn, info, debug, trace (default: info in prod, debug in dev)
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 7. Optional Integrations (Future Phases)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=your_email_api_key
