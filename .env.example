# ==============================================================================
# RentSphere API - Environment Configuration Template
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=3000

# Client Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:4200

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentsphere_db?schema=public

# JWT Secrets (Generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Future Integrations
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=your_email_api_key
