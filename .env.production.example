# ==============================================================================
# RentSphere API - Production Environment Configuration
# Target Platform: Render Web Service (https://render.com)
# ==============================================================================
# In Render, configure these environment variables under Service Settings > Environment.
# NEVER commit the actual .env file or production credentials to Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=10000

# Restricted CORS origins for production (e.g. Vercel deployment URL)
CORS_ORIGIN=https://rentsphere.vercel.app

# ------------------------------------------------------------------------------
# 2. Database Connection (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Use the pooled connection string from Neon Console (with ?sslmode=require)
# Example: postgresql://user:password@ep-pooler.neon.tech/rentsphere_db?sslmode=require
DATABASE_URL=postgresql://user:password@ep-pooler.neon.tech/rentsphere_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. JWT Authentication Secrets (Cryptographically Secure)
# ------------------------------------------------------------------------------
# Generate distinct 32+ character secrets using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=paste_cryptographically_secure_access_secret_min_32_chars
JWT_REFRESH_SECRET=paste_cryptographically_secure_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Media Storage (Cloudinary Production Account)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_production_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_production_cloudinary_api_key
CLOUDINARY_API_SECRET=your_production_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. Security & Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# 6. Structured Logging
# ------------------------------------------------------------------------------
# In production, logs are output as JSON strings (Pino default)
LOG_LEVEL=info
