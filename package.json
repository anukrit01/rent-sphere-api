{
  "name": "rent-sphere-api",
  "version": "1.0.0",
  "description": "Production REST API for RentSphere - Heavy Machinery & Equipment Leasing Marketplace",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "config:validate": "tsx src/config/validate.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "docker:db:up": "docker compose up -d",
    "docker:db:down": "docker compose down"
  },
  "keywords": [
    "rentsphere",
    "heavy-equipment",
    "machinery",
    "leasing",
    "marketplace",
    "express",
    "typescript",
    "postgresql",
    "prisma"
  ],
  "author": "RentSphere Engineering Team (Anukrit Tiwari)",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rent-sphere-ui": "file:../rent-sphere-ui",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.1",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
